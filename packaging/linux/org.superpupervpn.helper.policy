<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<policyconfig>
  <vendor>SuperPuperVPN</vendor>
  <action id="org.superpupervpn.helper.control">
    <description>Control the SuperPuperVPN connection</description>
    <description xml:lang="ru">Управление подключением SuperPuperVPN</description>
    <message>Authentication is required to control the SuperPuperVPN connection</message>
    <message xml:lang="ru">Для управления подключением SuperPuperVPN нужна аутентификация</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
